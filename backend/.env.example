# Copie este arquivo para ".env" (na pasta backend). NUNCA envie o .env para o GitHub.
# Usado na sua máquina pelos comandos: npm run seed:env  e  npm run start:env

# String de conexão do MongoDB Atlas (troque usuário, senha e endereço do cluster)
MONGODB_URI=mongodb+srv://USUARIO:SENHA@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority&appName=Cluster0
DB_NAME=simulado_ifma

# Chave longa e aleatória. Gere com:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cole-aqui-a-chave-gerada

# Senha inicial do professor (professor@simuladoifma.com) criada pelo seed
SEED_PROFESSOR_SENHA=defina-uma-senha-forte
